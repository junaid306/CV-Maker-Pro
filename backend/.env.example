# Copy to .env and replace placeholders. NEVER commit the real .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_DB_ENGINE=mysql          # use sqlite for a quick local test without MySQL

DB_NAME=cv_maker
DB_USER=cv_maker_user
DB_PASSWORD=replace-this-password
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://10.0.2.2:8000,http://localhost:8000

# 32-byte key (base64) used to encrypt AI provider API keys at rest.
FIELD_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# AdMob server-side verification public keys are fetched from Google at runtime;
# pin known key ids here if you want to avoid the network fetch on every callback.
ADMOB_SSV_PUBLIC_KEY_ID=
ADMOB_SSV_PUBLIC_KEY=
